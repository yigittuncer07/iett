[Unit]
Description=IETT fleet position collector
After=network-online.target
Wants=network-online.target

[Service]
# Edit User and the paths to match where the repo is checked out.
User=jeff
WorkingDirectory=/home/jeff/projects/iett
ExecStart=/usr/bin/python3 -u collect.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
